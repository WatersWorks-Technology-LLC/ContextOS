{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextOS Semantic IR",
  "type": "object",
  "required": [
    "version",
    "entities",
    "assertions"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "relation",
          "state",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "literal": {},
          "state": {
            "enum": [
              "current",
              "historical",
              "proposed",
              "rejected",
              "unknown"
            ]
          },
          "strength": {
            "enum": [
              "hard",
              "normal",
              "soft"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "origin": {
            "enum": [
              "explicit",
              "observed",
              "derived",
              "inferred"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}